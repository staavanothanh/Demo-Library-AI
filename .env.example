PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/Library?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
NODE_ENV=development
# Local HTTP: 0 trusted proxy hops. Render HTTPS: set this to 1.
TRUST_PROXY_HOPS=0
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free
OPENCODE_ZEN_API_KEY=replace-with-your-opencode-zen-key
POLICY_VECTOR_INDEX_NAME=policy_chunks_vector
AI_REQUEST_TIMEOUT_MS=15000
AI_RATE_LIMIT=20
AUTH_RATE_LIMIT=5
RECOMMENDATION_RATE_LIMIT=20
CATALOG_STARTUP_RETRY_ATTEMPTS=5
CATALOG_STARTUP_RETRY_BASE_MS=1000
CATALOG_STARTUP_RETRY_MAX_MS=30000
