<%- include("partials/header") %>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-motif" aria-hidden="true"><span></span></div>
    <div class="hero-copy">
      <p class="eyebrow">A CONSIDERED READING ROOM</p>
      <h1 id="hero-title">Find the next book that moves your ideas forward.</h1>
      <p class="hero-intro">Browse a focused collection of useful, beautiful books. Search by feeling, subject, or the
        question you cannot stop thinking about.</p>
      <div class="actions">
        <% if (user) { %><a class="button" href="/booklist">Browse the catalog</a>
          <% } else { %><a class="button" href="/register">Create an account</a><a class="button secondary"
              href="/login">Sign in</a>
            <% } %>
      </div>
    </div>
    <aside class="hero-note" aria-label="Store note"><span class="hero-note-mark" aria-hidden="true">✦</span>
      <p>Good books make room for better questions.</p><small>Leaf &amp; Logic, since 2024</small>
    </aside>
  </section>
  <section class="feature-grid" aria-labelledby="why-title">
    <div class="section-intro">
      <p class="eyebrow">THE LEAF &amp; LOGIC WAY</p>
      <h2 id="why-title">A smaller, sharper shelf.</h2>
    </div>
    <article><span class="feature-number">01</span>
      <h3>Organize</h3>
      <p>Search a carefully maintained catalog while our librarians keep the shelf useful.</p>
    </article>
    <article><span class="feature-number">02</span>
      <h3>Discover</h3>
      <p>Describe what you want to learn in natural language—not just exact keywords.</p>
    </article>
    <article><span class="feature-number">03</span>
      <h3>Learn</h3>
      <p>Semantic recommendations help you follow a thread from one good book to the next.</p>
    </article>
  </section>
  <%- include("partials/footer") %>
