<button class="chat-launcher" type="button" aria-controls="chat-panel" aria-expanded="false" data-chat-toggle>Chat</button>
<section class="chat-panel" id="chat-panel" hidden data-chat-panel>
  <div class="chat-panel-header"><strong>Leaf & Logic assistant</strong><button type="button" data-chat-close aria-label="Close chat">×</button></div>
  <p class="chat-notice">Demo assistant. Do not send passwords, payment details, or confidential information.</p>
  <div class="chat-messages" data-chat-messages aria-live="polite"></div>
  <form class="chat-form" data-chat-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="sr-only" for="chat-message">Message</label>
    <input id="chat-message" name="message" maxlength="2000" placeholder="Ask about books or store policies" required>
    <button class="button" type="submit">Send</button>
  </form>
</section>
<script src="/js/chatbot.js" defer></script>
