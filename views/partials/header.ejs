<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Leaf & Logic Books</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <header class="site-header">
    <a class="brand" href="/">Leaf <span>&</span> Logic Books</a>
    <nav>
      <a href="/books">Books</a>
      <a href="/cart">Cart (<%= cartCount || 0 %>)</a>
      <% if (user) { %>
        <% if (user.role === "admin") { %><a href="/admin-dashboard">Add book</a><% } %>
        <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button">Log out</button></form>
      <% } else { %>
        <a href="/login">Sign in</a><a class="nav-button" href="/register">Create account</a>
      <% } %>
    </nav>
  </header>
  <main>
    <% if (message) { %>
      <p class="notice">
        <%= message %>
      </p>
      <% } %>