<%- include("partials/header") %>
    <section class="form-card wide recommendation-card">
        <p class="eyebrow">SEMANTIC RECOMMENDATIONS</p>
        <h1>Ask AI Finder</h1>
        <p>Describe what you want to learn or read. The local recommendation model compares your request with the
            catalog.</p>
        <form id="recommendation-form">
            <div class="field"><label for="prompt">What kind of book are you looking for?</label><textarea id="prompt"
                    rows="4"
                    placeholder="For example: a practical book about backend APIs and scalable JavaScript systems."
                    required></textarea></div><button class="button" type="submit">Find books</button>
        </form>
        <div id="recommendation-result" class="recommendation-result" aria-live="polite" aria-atomic="true"></div>
    </section>
    <script src="/js/recommendations.js" defer></script>
    <%- include("partials/footer") %>