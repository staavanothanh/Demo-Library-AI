<%- include("partials/header") %>
    <section class="form-card wide">
        <p class="eyebrow">ADMINISTRATION</p>
        <h1>Add a book to the collection</h1>
        <p>New books refresh the semantic recommendation index automatically.</p><%- include("partials/errors", { errors
            }) %>
            <form method="post" action="/admin-dashboard/add-book"><label>Title<input name="title"
                        value="<%= values.title || "" %>" required></label><label>Authors<input name="authors"
                        value="<%= values.authors || "" %>" required></label><label>Genre<input name="genre"
                        value="<%= values.genre || "" %>"></label><label>Publisher<input name="publisher"
                        value="<%= values.publisher || "" %>"></label><label>Publication date<input
                        name="publicationDate" value="<%= values.publicationDate || "" %>"
                        placeholder="2024"></label><label>Average rating<input name="averageRating" type="number"
                        min="0" max="5" step="0.1" value="<%= values.averageRating || "" %>"></label><label>Price (USD)<input name="price" type="number" min="0" step="0.01" value="<%= values.price || "" %>" required></label><label>Stock<input name="stock" type="number" min="0" step="1" value="<%= values.stock || "" %>" required></label><label>Cover URL<input name="coverUrl" type="url" value="<%= values.coverUrl || "" %>" placeholder="https://..."></label><label
                    class="full">Description<textarea name="description" rows="5"
                        required><%= values.description || "" %></textarea></label><button class="button"
                    type="submit">Add book</button></form>
    </section>
    <%- include("partials/footer") %>