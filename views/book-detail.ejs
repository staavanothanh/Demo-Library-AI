<%- include("partials/header") %>
  <section class="form-card wide product-detail product-card">
    <div class="product-media" data-book-tilt>
      <% if (book.coverUrl) { %><img class="product-cover" src="<%= book.coverUrl %>" alt="Cover of <%= book.title %>">
      <% } else { %>
        <div class="product-cover placeholder" aria-hidden="true">No cover</div>
      <% } %>
    </div>
    <div class="product-copy">
      <div class="product-meta">
        <p class="eyebrow"><%= book.genre || "BOOK" %></p>
        <h1><%= book.title %></h1>
        <p class="author">By <%= book.authors %></p>
      </div>
      <p class="product-kicker">A considered addition to your shelves</p>
      <p class="product-description"><%= book.description || "No description available." %></p>
      <div class="product-purchase">
        <div class="pricing-block">
          <p class="price"><%= formatCurrency(book.price) %></p>
          <p class="stock"><%= book.stock > 0 ? `${book.stock} available` : "Currently out of stock" %></p>
        </div>
        <% if (book.stock > 0) { %>
          <form class="inline-form purchase-form" action="/cart/items" method="post" data-cart-form
            hx-post="/cart/items" hx-target="#cart-feedback" hx-swap="outerHTML" hx-indicator="#cart-loading"
            hx-disabled-elt="find button">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="bookId" value="<%= book._id %>">
            <div class="field quantity-field">
              <label for="quantity">Quantity</label>
              <input id="quantity" name="quantity" type="number" min="1" max="<%= book.stock %>" value="1" required>
            </div>
            <button class="button" type="submit">Add to cart</button>
          </form>
          <p id="cart-feedback" class="notice cart-status" data-cart-status data-htmx-fragment-target role="status"
            aria-live="polite" hidden></p>
          <p id="cart-loading" class="htmx-indicator muted" role="status" aria-live="polite">Adding to your cart…</p>
        <% } %>
      </div>
    </div>
  </section>
  <%- include("partials/comments-section", { bookId: book._id, comments, user, csrfToken }) %>
  <script src="/vendor/vanilla-tilt.min.js" defer></script>
  <script src="/js/effects.js" defer></script>
  <%- include("partials/footer") %>
