<%- include("partials/header") %>
  <section class="page-heading product-heading">
    <p class="eyebrow">
      <%= book.genre || "BOOK" %>
    </p>
    <h1>
      <%= book.title %>
    </h1>
    <p class="author">By <%= book.authors %>
    </p>
  </section>
  <section class="form-card wide product-detail">
    <div class="product-media">
      <% if (book.coverUrl) { %><img class="product-cover" src="<%= book.coverUrl %>" alt="Cover of <%= book.title %>">
        <% } else { %>
          <div class="product-cover placeholder" aria-hidden="true">No cover</div>
          <% } %>
    </div>
    <div class="product-copy">
      <p class="product-description">
        <%= book.description || "No description available." %>
      </p>
      <p class="price">
        <%= formatCurrency(book.price) %>
      </p>
      <p class="stock">
        <%= book.stock> 0 ? `${book.stock} available` : "Currently out of stock" %>
      </p>
      <% if (book.stock> 0) { %><form class="inline-form" action="/cart/items" method="post"><input type="hidden"
            name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="bookId" value="<%= book._id %>">
          <div class="field"><label for="quantity">Quantity</label><input id="quantity" name="quantity" type="number"
              min="1" max="<%= book.stock %>" value="1" required></div><button class="button" type="submit">Add to
            cart</button>
        </form>
        <% } %>
    </div>
  </section>
  <section class="form-card wide comments-section">
    <div class="section-heading">
      <p class="eyebrow">FROM THE COMMUNITY</p>
      <h2>Customer comments</h2>
    </div>
    <% if (!comments.length) { %>
      <p class="muted">No comments yet. Be the first to share a thought.</p>
      <% } %>
        <div class="comments-list">
          <% comments.forEach((comment)=> { %><article class="comment"><strong>
                <%= comment.userId?.username || "Member" %>
              </strong>
              <p>
                <%= comment.body %>
              </p>
            </article>
            <% }) %>
        </div>
        <% if (user) { %>
          <form action="/books/<%= book._id %>/comments" method="post"><input type="hidden" name="_csrf"
              value="<%= csrfToken %>">
            <div class="field"><label for="comment-body">Leave a comment</label><textarea id="comment-body" name="body"
                rows="4" maxlength="1000" required></textarea></div><button class="button" type="submit">Post
              comment</button>
          </form>
          <% } else { %>
            <p><a href="/login">Sign in</a> to leave a comment.</p>
            <% } %>
  </section>
  <%- include("partials/footer") %>