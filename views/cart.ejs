<%- include("partials/header") %>
    <section class="page-heading">
        <p class="eyebrow">YOUR CART</p>
        <h1>Ready when you are.</h1>
        <p>A short list of books waiting for you.</p>
    </section>
    <% if (!items.length) { %>
        <section class="form-card wide empty-state">
            <p>Your cart is empty.</p><a class="text-link" href="/books">Browse the collection <span
                    aria-hidden="true">→</span></a>
        </section>
        <% } else { %>
            <section class="form-card wide cart-card">
                <div class="cart-items">
                    <% items.forEach((item)=> { %><article class="cart-row">
                            <div class="cart-item-copy">
                                <h2><a href="/books/<%= item.book._id %>">
                                        <%= item.book.title %>
                                    </a></h2>
                                <p>
                                    <%= formatCurrency(item.book.price) %> each
                                </p>
                            </div>
                            <form class="cart-update" action="/cart/items/<%= item.book._id %>/update" method="post">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="field"><label for="quantity-<%= item.book._id %>">Quantity</label><input
                                        id="quantity-<%= item.book._id %>" name="quantity" type="number" min="1"
                                        max="<%= item.book.stock %>" value="<%= item.quantity %>" required></div><button
                                    class="button secondary" type="submit">Update</button>
                            </form><strong class="cart-subtotal">
                                <%= formatCurrency(item.subtotalCents / 100) %>
                            </strong>
                            <form action="/cart/items/<%= item.book._id %>/remove" method="post"><input type="hidden"
                                    name="_csrf" value="<%= csrfToken %>"><button class="link-button"
                                    type="submit">Remove</button></form>
                        </article>
                        <% }) %>
                </div>
                <div class="cart-total"><strong>Total</strong><strong>
                        <%= formatCurrency(total) %>
                    </strong></div>
                <div class="cart-actions">
                    <form action="/checkout" method="post"><input type="hidden" name="_csrf"
                            value="<%= csrfToken %>"><button class="button" type="submit">Demo checkout</button></form>
                    <form action="/cart/clear" method="post"><input type="hidden" name="_csrf"
                            value="<%= csrfToken %>"><button class="button secondary" type="submit">Clear cart</button>
                    </form>
                </div>
            </section>
            <% } %>
                <%- include("partials/footer") %>