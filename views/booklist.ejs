<%- include("partials/header") %>
  <section class="page-heading">
    <p class="eyebrow">THE COLLECTION</p>
    <h1>Find your next book</h1>
    <p>Search the catalog by title, author, or genre.</p>
  </section>
  <form class="search-form" action="/books" method="get" role="search" data-catalog-form
    hx-get="/books" hx-target="#catalog-results" hx-swap="outerHTML transition:true" hx-push-url="true"
    hx-indicator="#catalog-loading" hx-disabled-elt="find button" hx-sync="closest form:replace">
    <div class="field">
      <label for="catalog-query">Search the collection</label>
      <input id="catalog-query" data-catalog-query name="q" value="<%= query %>" maxlength="120"
        placeholder="Title, author, or genre" hx-get="/books" hx-trigger="input changed delay:350ms, search"
        hx-target="#catalog-results" hx-swap="outerHTML transition:true" hx-push-url="true"
        hx-indicator="#catalog-loading" hx-sync="closest form:replace" hx-include="closest form">
    </div>
    <div class="field">
      <label for="catalog-sort">Sort by</label>
      <select id="catalog-sort" name="sort" hx-get="/books" hx-trigger="change" hx-target="#catalog-results"
        hx-swap="outerHTML transition:true" hx-push-url="true" hx-indicator="#catalog-loading"
        hx-sync="closest form:replace" hx-include="closest form">
        <option value="title" <%= filters.sort === "title" ? "selected" : "" %>>Title</option>
        <option value="price-asc" <%= filters.sort === "price-asc" ? "selected" : "" %>>Price: low to high</option>
        <option value="price-desc" <%= filters.sort === "price-desc" ? "selected" : "" %>>Price: high to low</option>
        <option value="rating" <%= filters.sort === "rating" ? "selected" : "" %>>Rating</option>
      </select>
    </div>
    <button class="button" type="submit">Search books</button>
  </form>
  <p id="catalog-loading" class="htmx-indicator muted" role="status" aria-live="polite">Loading catalog results…</p>
  <%- include("partials/catalog-results", { books, query, filters, currentPage, totalPages, totalBooks, pageSize }) %>
  <%- include("partials/footer") %>
