<%- include("partials/header") %>
<section class="page-heading">
    <p class="eyebrow">THE COLLECTION</p>
    <h1>Find your next book</h1>
    <p>Search the catalog by title, author, or genre.</p>
</section>
<form class="search-form" action="/books" method="get">
    <input name="q" value="<%= query %>" maxlength="120" placeholder="Search title, author, or genre">
    <select name="sort" aria-label="Sort books">
        <option value="title" <%= filters.sort === "title" ? "selected" : "" %>>Title</option>
        <option value="price-asc" <%= filters.sort === "price-asc" ? "selected" : "" %>>Price: low to high</option>
        <option value="price-desc" <%= filters.sort === "price-desc" ? "selected" : "" %>>Price: high to low</option>
        <option value="rating" <%= filters.sort === "rating" ? "selected" : "" %>>Rating</option>
    </select>
    <button class="button" type="submit">Search</button>
</form>
<p class="muted"><%= totalBooks %> books · page <%= currentPage %> of <%= totalPages %></p>
<section class="book-grid">
    <% books.forEach((book)=> { %><article class="book-card">
        <% if (book.coverUrl) { %><img class="book-cover" src="<%= book.coverUrl %>" alt="Cover of <%= book.title %>"><% } else { %><div class="book-cover placeholder" aria-hidden="true">No cover</div><% } %>
        <p class="tag"><%= book.genre || "Book" %></p>
        <h2><a href="/books/<%= book._id %>"><%= book.title %></a></h2>
        <p class="author"><%= book.authors %></p>
        <p><strong><%= formatCurrency(book.price) %></strong> · <%= book.averageRating || "—" %>/5</p>
        <p><%= book.stock > 0 ? `${book.stock} in stock` : "Out of stock" %></p>
        <a class="button" href="/books/<%= book._id %>">View details</a>
    </article><% }) %>
</section>
<% if (!books.length) { %><p class="empty">No books matched your search. Try a different phrase.</p><% } %>
<% if (totalPages > 1) { %>
<nav class="pagination" aria-label="Book pages">
    <% for (let page = 1; page <= totalPages; page += 1) { %>
        <a href="/books?page=<%= page %>&limit=<%= pageSize %>&q=<%= encodeURIComponent(query) %>&sort=<%= filters.sort %>" <%= page === currentPage ? "aria-current=page" : "" %>><%= page %></a>
    <% } %>
</nav>
<% } %>
<%- include("partials/footer") %>